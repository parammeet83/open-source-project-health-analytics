# Copy to .env (git-ignored) for local development. Never commit real values.
# All values below are placeholders.

# Optional for local runs; strongly recommended (unauthenticated limit is 60 requests/hour).
# Fine-grained personal access token with public-repository read-only access; no scopes needed.
GITHUB_TOKEN=

# Pipeline writer role (oss_health_app). Used by `oss-health run`.
PIPELINE_DATABASE_URL=postgresql://oss_health_app:CHANGE_ME@localhost:5432/osp_health_dev

# Schema owner / migration credential. Used by `oss-health db upgrade` and `db bootstrap-roles`.
MIGRATION_DATABASE_URL=postgresql://oss_health_owner:CHANGE_ME@localhost:5432/osp_health_dev

# Read-only API role (oss_health_reader). Used by the FastAPI service.
API_DATABASE_URL=postgresql://oss_health_reader:CHANGE_ME@localhost:5432/osp_health_dev

# Passwords used by `oss-health db bootstrap-roles` (>= 24 characters, random).
OSS_HEALTH_APP_PASSWORD=
OSS_HEALTH_READER_PASSWORD=

# API settings
CORS_ALLOWED_ORIGINS=http://localhost:5173
# CORS_ALLOW_ORIGIN_REGEX=^https://open-source-project-health-analytics-[a-z0-9-]+\.vercel\.app$

# Integration tests: MUST be a dedicated local database whose name ends in _test.
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/osp_health_test
DEV_DATABASE_URL=postgresql://postgres@localhost:5432/osp_health_dev
